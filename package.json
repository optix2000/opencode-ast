{
  "name": "opencode-ast",
  "version": "0.2.0",
  "description": "AST plugin for OpenCode — tree-sitter powered code structure analysis",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "bundle": "bun run bundle.ts",
    "update:wasm-manifest": "bun run update-wasm-manifest.ts",
    "prepublishOnly": "bun run bundle"
  },
  "engines": {
    "bun": ">=1.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "dependencies": {
    "effect": "4.0.0-beta.59",
    "web-tree-sitter": "0.26.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.14.41",
    "@types/bun": "1.3.13",
    "typescript": "^6.0.3"
  }
}
